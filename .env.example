# Copy to .env and fill in values

# REQUIRED in production (min 32 chars)
SECRET_KEY=replace-with-at-least-32-char-random-string

FLASK_ENV=production
PORT=8000

# Cookies / TLS (enable when serving over HTTPS)
SESSION_COOKIE_SECURE=true
FORCE_HTTPS=true

# Set false to disable public sign-up
ALLOW_REGISTRATION=true

MIN_PASSWORD_LENGTH=10

# Optional: Redis for multi-worker rate limits
# RATELIMIT_STORAGE_URI=redis://localhost:6379

# Optional email reminders
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_DEFAULT_SENDER=you@gmail.com
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587

# Optional Postgres
# DATABASE_URL=postgresql://user:pass@host:5432/accounts
